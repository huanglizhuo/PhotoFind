<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The GPU model reserves large virtual address ranges on device. (T1: JavaScriptCore is gone; T4 checks whether this entitlement is still needed.) -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.clothpath.mondigital</string>
	</array>
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
</dict>
</plist>
